# Swift / SwiftPM
.build/
.swiftpm/
Package.resolved

# Xcode (generated project — source of truth is project.yml)
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/
*.xcuserstate

# Xcode build output (xcodebuild -derivedDataPath build)
/build/

# Transient icon-generation artifacts (run scripts/generate-icons.sh to rebuild).
# Source: vault-verse.png. Produced app icons live in App/Resources/.
/scripts/AppIcon.iconset/
/scripts/AppIcon.icns

# Generated by XcodeGen from project.yml
App/Resources/Info.plist

# macOS
.DS_Store

# VaultVerse local data / exports produced at runtime
/.vaultverse/
*.vaultverse-export.json
*.vaultverse-export.csv

# Secrets (never commit Apple Music credentials)
*.p8
.env
.env.local
